CREATE PROCEDURE [WebServices].[InsertCustomDefinedColumn]
    @AV_CUSTOMDEFINEDCOLUMNID INT = NULL OUTPUT ,
    @AV_TABLENAME NVARCHAR(50) ,
    @AV_COLUMNNAME NVARCHAR(50) ,
    @AV_DISPLAYNAME NVARCHAR(50) ,
    @AV_COLUMNTYPE NVARCHAR(50) ,
    @AV_COLUMNSIZE INT ,
    @AV_COLUMNPRECISION INT ,
    @AV_DATEONLY NVARCHAR(1) ,
    @AV_TIMEONLY NVARCHAR(1) ,
    @AV_LOOKUPLISTID INT = NULL ,
    @AV_CUSTOMCOLUMNGROUPID INT ,
    @AV_ISREADONLY NVARCHAR(1) ,
    @AV_CONTROLHEIGHT SMALLINT = 0 ,
    @AV_POS INT = 0 ,
    @AV_BoldFont BIT ,
    @AV_SectorIdCsv NVARCHAR(MAX) ,
    @UserId INT ,
    @AV_IncludeInPermanentJobWizard BIT ,
    @AV_IncludeInContractJobWizard BIT ,
    @AV_FormLeftRightPosition NVARCHAR(5),
    @AV_InfoTipText NVARCHAR(1000)
AS
    DECLARE @TEMP AS TABLE
        (
            CUSTOMDEFINEDCOLUMNID INT ,
            CREATEDON DATETIME ,
            UPDATEDTIMESTAMP VARBINARY(8)
        );
    IF NOT EXISTS (   SELECT *
                      FROM   dbo.CustomDefinedColumns
                      WHERE  CustomDefinedColumnId = @AV_CUSTOMDEFINEDCOLUMNID )
        BEGIN
            DECLARE @ActualTableName NVARCHAR(MAX) = NULL;
            SELECT @ActualTableName = UPPER(REPLACE(REPLACE(QUOTENAME(TABLE_NAME), '[', ''), ']', ''))
            FROM   INFORMATION_SCHEMA.TABLES
            WHERE  TABLE_NAME = @AV_TABLENAME
                   AND TABLE_NAME IN ( 'ApplicantSectorDefinedColumns', 'ClientSectorDefinedColumns', 'JobSectorDefinedColumns', 'ContactSectorDefinedColumns', 'PlacementSectorDefinedColumns', 'ProjectSectorDefinedColumns' );
            IF @ActualTableName IS NOT NULL
                BEGIN

					-- RCRM displays the default control height as 1 (which makes more sense) but the dbo procs use 0 so change it here
					IF @AV_CONTROLHEIGHT = 1
						BEGIN
							SET @AV_CONTROLHEIGHT = 0
					END;

                    INSERT INTO @TEMP
                    EXEC dbo.CUSTOM_DEFINED_COLUMN_INSERT @AV_TABLENAME = @ActualTableName ,                  -- nvarchar(50)            
                                                          @AV_COLUMNNAME = @AV_COLUMNNAME ,                   -- nvarchar(50)            
                                                          @AV_DISPLAYNAME = @AV_DISPLAYNAME ,                 -- nvarchar(50)            
                                                          @AV_COLUMNTYPE = @AV_COLUMNTYPE ,                   -- nvarchar(50)            
                                                          @AV_COLUMNSIZE = @AV_COLUMNSIZE ,                   -- int            
                                                          @AV_COLUMNPRECISION = @AV_COLUMNPRECISION ,         -- int            
                                                          @AV_DATEONLY = @AV_DATEONLY ,                       -- nvarchar(1)            
                                                          @AV_TIMEONLY = @AV_TIMEONLY ,                       -- nvarchar(1)            
                                                          @AV_LOOKUPLISTID = @AV_LOOKUPLISTID ,               -- int            
                                                          @AV_CUSTOMCOLUMNGROUPID = @AV_CUSTOMCOLUMNGROUPID , -- int            
                                                          @AV_ISREADONLY = @AV_ISREADONLY ,                   -- nvarchar(1)            
                                                          @AV_CREATEDUSERID = @UserId ,                       -- int            
                                                          @AV_UPDATEDUSERID = @UserId ,                       -- int            
                                                          @AV_CONTROLHEIGHT = @AV_CONTROLHEIGHT ,             -- smallint            
                                                          @AV_POS = @AV_POS ,                                 -- int            
