CREATE PROCEDURE [WebServices].[UserIdentityInsert]
(
    @Firstname NVARCHAR(150),
    @Lastname NVARCHAR(50),
    @JobTitle NVARCHAR(100),
    @Email NVARCHAR(255),
    @ExecutingEmail NVARCHAR(255) = NULL
)
AS
BEGIN

    INSERT INTO dbo.Users
    (
        LoginName,
        Password,
        UserName,
        Surname,
        JobTitle,
        EmailAddress,
        Inactive,
        SecurityOption,
        Photograph,
        CreatedUserId,
        CreatedOn,
        UpdatedUserId,
        ReportsToUserId,
        UseWindowsSecurity,
        Domain,
        HideLoginDialog,
        Sid,
        TimeOffsetInMinutes,
        UpdatedOn,
        IdentityEmail
    )
    VALUES
    (   @Email, -- LoginName - nvarchar(20)
        NULL,           -- Password - nvarchar(255)
        @Firstname,     -- UserName - nvarchar(150)
        @Lastname,      -- Surname - nvarchar(50)
        @JobTitle,      -- JobTitle - nvarchar(100)
        @Email,         -- EmailAddress - nvarchar(255)
        N'N',           -- Inactive - nvarchar(1)
        N'N',           -- SecurityOption - nvarchar(1)
        NULL,           -- Photograph - varbinary(max)
        ISNULL(
        (
            SELECT TOP 1
                   UserId
            FROM dbo.Users
            WHERE ISNULL(IdentityEmail, EmailAddress) = @ExecutingEmail
        ),
        1),        -- CreatedUserId - int
        GETDATE(),      -- CreatedOn - datetime
        NULL,        -- UpdatedUserId - int
        NULL,           -- ReportsToUserId - int
        0,              -- UseWindowsSecurity - bit
        NULL,           -- Domain - nvarchar(255)
        NULL,           -- HideLoginDialog - bit
        NULL,           -- Sid - nvarchar(255)
        0,              -- TimeOffsetInMinutes - smallint
        GETDATE(),      -- UpdatedOn - datetime
        @Email  -- IdentityEmail - nvarchar(255)
        );

    DECLARE @UserId INT;

    SET @UserId = SCOPE_IDENTITY();

	IF EXISTS(SELECT *
          FROM   INFORMATION_SCHEMA.COLUMNS
          WHERE  TABLE_NAME = 'Sectors'
                 AND COLUMN_NAME = 'DefaultSector') 
	BEGIN
		DECLARE @SectorInsertSql NVARCHAR(max) 

		SET @SectorInsertSql = 'INSERT INTO dbo.SectorUsers
		(
			SectorId,
			UserId,
			HasLoggedOn,
			CreatedUserId,
			CreatedOn
		)
		SELECT S.SectorId,
			   ' + CAST(@UserId AS NVARCHAR(100)) +',
			   ''Y'',
			   ' + CAST(@UserId AS NVARCHAR(100)) +',
			   GETDATE()
		FROM dbo.Sectors S
		WHERE isnull(S.DefaultSector, 0) = 1
		'
		EXEC (@SectorInsertSql)
	END

	IF NOT EXISTS (SELECT * FROM dbo.SectorUsers WHERE UserId = @UserId)
	BEGIN
	    INSERT INTO dbo.SectorUsers
		(
			SectorId,
			UserId,
			HasLoggedOn,
			CreatedUserId,
			CreatedOn
		)
		SELECT S.SectorId,
			   @UserId,
			   'Y',
			   @UserId,
			   GETDATE()			   
		FROM dbo.Sectors S
		WHERE S.SectorId = 47
	END

	IF NOT EXISTS (SELECT * FROM dbo.SectorUsers WHERE UserId = @UserId)
	BEGIN
	    INSERT INTO dbo.SectorUsers
		(
			SectorId,
			UserId,
			HasLoggedOn,
			CreatedUserId,
			CreatedOn
		)
		SELECT TOP (1) S.SectorId,
			   @UserId,
			   'Y',
			   @UserId,
			   GETDATE()			   
		FROM dbo.Sectors S

	END

	  INSERT INTO dbo.UserRoles
	  (
		  UserId,
		  RoleId,
		  CreatedUserId,
		  CreatedOn
	  )
	SELECT @UserId,
		R.RoleId, 
		@UserId, 
		GETDATE()
		FROM Roles R
		WHERE R.RoleId = 2


    SELECT @UserId AS UserId;
END;
GO
