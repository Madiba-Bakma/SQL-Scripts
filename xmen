CREATE PROCEDURE [WebServices].[TableAlterStatements]
    @TableName AS NVARCHAR(MAX) ,
    @DbColumnType AS NVARCHAR(MAX) ,
    @ColumnName AS NVARCHAR(MAX) ,
    @ColumnSize AS INT ,
    @ColumnPrecision AS INT ,
    @LookupListId AS INT ,
    @RETURNVALUE INT OUTPUT
AS
    DECLARE @SqlQuery NVARCHAR(MAX);

    DECLARE @ActualTableName NVARCHAR(MAX) = NULL;
    DECLARE @ActualColumnType AS NVARCHAR(MAX) = NULL;

    SELECT @ActualTableName = QUOTENAME(TABLE_NAME)
    FROM   INFORMATION_SCHEMA.TABLES
    WHERE  TABLE_NAME = @TableName
           AND TABLE_NAME IN ( 'ApplicantSectorDefinedColumns', 'ClientSectorDefinedColumns', 'JobSectorDefinedColumns', 'ContactSectorDefinedColumns', 'PlacementSectorDefinedColumns', 'ProjectSectorDefinedColumns' );


    SELECT @ActualColumnType = QUOTENAME(t.name)
    FROM   sys.columns c
           INNER JOIN sys.types t ON t.user_type_id = c.user_type_id
    WHERE  t.name = @DbColumnType
           AND t.name IN ( 'DATETIME', 'NVARCHAR', 'NUMERIC', 'INT', 'BIT' );




    IF ( UPPER(@ActualColumnType) = '[NVARCHAR]' )
        BEGIN
            SET @ActualColumnType = @ActualColumnType + N'(' + CONVERT(NVARCHAR(MAX), @ColumnSize) + N')';
        END;
    ELSE IF ( UPPER(@ActualColumnType) = '[NUMERIC]' )
             BEGIN
                 SET @ActualColumnType = @ActualColumnType + N'(' + CONVERT(NVARCHAR(MAX), @ColumnSize) + N',' + CONVERT(NVARCHAR(MAX), @ColumnPrecision) + N')';
             END;

    IF NOT EXISTS (   SELECT 1
                      FROM   sys.columns
                      WHERE  name = @ColumnName
                             AND object_id = OBJECT_ID(@ActualTableName))
        BEGIN
            SET @SqlQuery = N'ALTER TABLE' + N' ' + UPPER(@ActualTableName) + N' ' + N'ADD' + N' ' + @ColumnName + N' ' + @ActualColumnType + N' ' + N'NULL';

            IF ( @LookupListId > 0 )
                BEGIN
                    SET @SqlQuery = @SqlQuery + N' ' + N'CONSTRAINT' + N' ' + REPLACE(REPLACE(UPPER(@ActualTableName), ']', ''), '[', '') + N'_' + @ColumnName + N'_FK' + N' ' + N'FOREIGN KEY REFERENCES LISTVALUES(LISTVALUEID)';
                END;


            EXECUTE sp_executesql @SqlQuery;

        END;
    IF ( @@error <> 0 )
        SET @RETURNVALUE = 1;
    ELSE
        SET @RETURNVALUE = 0;
GO
