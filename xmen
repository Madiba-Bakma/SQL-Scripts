CREATE PROCEDURE [dbo].[DT_ADD_CUSTOM_APPLICANT_COLUMN]
    (
      @ColumnName VARCHAR(100) ,
      @ColumnTypeSql VARCHAR(500) ,
      @ColumnDescription VARCHAR(500) = NULL ,
      @DateOnly VARCHAR(1) = 'N' ,
      @TimeOnly VARCHAR(1) = 'N' ,
      @LookupListId INT = NULL ,
      @GroupName VARCHAR(250) = NULL ,
      @SectorId INT = NULL
    )
AS 
    BEGIN
        SET NOCOUNT ON;
        
        DECLARE @ColumnType VARCHAR(100) ,
            @ColumnSize INT ,
            @ColumnPrecision INT;

        SET @ColumnPrecision = 0;
      
                           
                  
        SET @ColumnType = CASE WHEN @ColumnTypeSql = 'NVARCHAR(1)' THEN 'Boolean'
                               WHEN @ColumnTypeSql = 'DATETIME' THEN 'Date'
                               WHEN ISNULL(@LookupListId, 0) != 0 THEN 'Lookup'
                               WHEN @ColumnTypeSql LIKE '%VARCHAR%' THEN 'Text'
                               WHEN @ColumnTypeSql = 'Int' THEN 'Integer'
                               WHEN @ColumnTypeSql LIKE '%Numeric%' THEN 'Numeric'
                          END
        
                           
        
        
        SET @ColumnSize = CASE @ColumnType
                            WHEN 'Boolean' THEN 1
                            WHEN 'Lookup' THEN 0
                            WHEN 'Integer' THEN 0
                            WHEN 'Date' THEN 0
                            ELSE NULL
                          END 
                                                                     
        IF ( @ColumnSize IS NULL ) 
            BEGIN
                IF ( CHARINDEX(',', @ColumnTypeSql, 1) = 0 ) 
                    BEGIN
                        SET @ColumnSize = CAST(SUBSTRING(@ColumnTypeSql, CHARINDEX('(', @ColumnTypeSql, 1) + 1, ( LEN(@ColumnTypeSql) - CHARINDEX('(', @ColumnTypeSql, 1) - 1 )) AS INT)
                    END
                ELSE 
                    BEGIN
                                                       
                        SET @ColumnSize = CAST(SUBSTRING(@ColumnTypeSql, CHARINDEX('(', @ColumnTypeSql, 1) + 1, ( LEN(@ColumnTypeSql) - CHARINDEX('(', @ColumnTypeSql, 1) ) - ( LEN(@ColumnTypeSql) - CHARINDEX(',', @ColumnTypeSql, 1) + 1 )) AS INT)
                           
                        SET @ColumnPrecision = CAST(SUBSTRING(@ColumnTypeSql, CHARINDEX(',', @ColumnTypeSql, 1) + 1, ( LEN(@ColumnTypeSql) - CHARINDEX(',', @ColumnTypeSql, 1) - 1 )) AS INT)
                    END
            END                                    
                                
        IF ( @ColumnDescription IS NULL ) 
            BEGIN
                SET @ColumnDescription = @ColumnName
            END
    
        IF ( @GroupName IS NULL ) 
            BEGIN
                IF NOT EXISTS ( SELECT  *
                                FROM    CustomColumnGroups
                                WHERE   GroupName = 'Custom Columns' ) 
                    BEGIN
                        INSERT  INTO CustomColumnGroups
                                ( GroupName ,
                                  CreatedUserId ,
                                  UpdatedUserId ,
                                  CreatedOn
                                        
                                )
                        VALUES  ( 'Custom Columns' ,
                                  1 ,
                                  1 ,
                                  GETDATE()
                                )
                    END
                SET @GroupName = 'Custom Columns'
            END
        ELSE 
            BEGIN
                IF NOT EXISTS ( SELECT  *
                                FROM    CustomColumnGroups
                                WHERE   GroupName = @GroupName ) 
                    BEGIN
                        INSERT  INTO CustomColumnGroups
                                ( GroupName ,
                                  CreatedUserId ,
                                  UpdatedUserId ,
                                  CreatedOn
                                        
                                )
                        VALUES  ( @GroupName ,
                                  1 ,
                                  1 ,
                                  GETDATE()
                                )
                    END
            END

    
        IF ( @SectorId IS NULL ) 
            BEGIN
                SET @SectorId = ( SELECT TOP 1
                                            SectorId
                                  FROM      Sectors
                                  WHERE     SectorName LIKE '%Main%'
                                )
            END
        IF ( @SectorId IS NULL ) 
            BEGIN
                SET @SectorId = ( SELECT TOP 1
                                            SectorId
                                  FROM      Sectors
                                  ORDER BY  SectorId ASC
                                )
            END
    
        SET @ColumnName = SUBSTRING(@ColumnName, 1, 50)
        IF NOT EXISTS ( SELECT  *
                        FROM    INFORMATION_SCHEMA.COLUMNS
                        WHERE   TABLE_NAME = 'ApplicantSectorDefinedColumns'
                                AND COLUMN_NAME = @ColumnName ) 
            BEGIN
                EXEC ('ALTER TABLE [ApplicantSectorDefinedColumns] ADD ' + @ColumnName + ' ' + @ColumnTypeSql)

              
                INSERT  INTO [CustomDefinedColumns]
                        ( [TableName] ,
                          [ColumnName] ,
                          [DisplayName] ,
                          [ColumnType] ,
                          [ColumnSize] ,
                          [ColumnPrecision] ,
                          [Pos] ,
                          [DateOnly] ,
                          [TimeOnly] ,
                          [LookupListId] ,
                          [CreatedUserId] ,
                          [CreatedOn] ,
                          [CustomColumnGroupId]
                                                             
                        )
                        SELECT  'ApplicantSectorDefinedColumns' ,
                                @ColumnName ,
                                SUBSTRING(@ColumnDescription, 1, 50) ,
                                @ColumnType ,
                                @ColumnSize ,
                                @ColumnPrecision ,
                                ( SELECT    ISNULL(MAX(Pos), 1) + 1
                                  FROM      CustomDefinedColumns
                                  WHERE     TableName = 'ApplicantSectorDefinedColumns'
                                ) ,
                                @DateOnly ,
                                @TimeOnly ,
                                @LookupListId ,
                                1 ,
                                GETDATE() ,
                                ( SELECT    CustomColumnGroupId
                                  FROM      CustomColumnGroups
                                  WHERE     GroupName = @GroupName
                                )
                        WHERE   NOT EXISTS ( SELECT *
                                             FROM   [CustomDefinedColumns]
                                             WHERE  TableName = 'ApplicantSectorDefinedColumns'
                                                    AND ColumnName = @ColumnName )
                           
                INSERT  INTO [SectorDefinedColumns]
                        ( [SectorId] ,
                          [CustomDefinedColumnId] ,
                          [CreatedUserId] ,
                          [CreatedOn]
                                                             
                        )
                        SELECT DISTINCT
                                @SectorId ,
                                CDC.CustomDefinedColumnID ,
                                1 ,
                                GETDATE()
                        FROM    CustomDefinedColumns CDC
                        WHERE   CDC.ColumnName = @ColumnName
                                AND CDC.[CustomDefinedColumnId] NOT IN ( SELECT [CustomDefinedColumnId]
                                                                         FROM   [SectorDefinedColumns]
                                                                         WHERE  SectorId = @SectorId )
            END

    END
GO
