                            [P].[StartDate] ,                                                    -- FromDate - datetime  
                            [P].[EndDate] ,                                                      -- ToDate - datetime  
                            [P].[PositionAttributeId] ,                                          -- PositionAttributeId - int  
                            [P].[Description] ,                                                  -- Description - nvarchar(100)  
                            [P].[Notes] ,                                                        -- Notes - nvarchar(max)  
                            [P].[PlacementTypeId] ,                                              -- EmploymentTypeId - int  
