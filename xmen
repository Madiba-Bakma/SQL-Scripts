CREATE PROCEDURE [RecPortal].[ValidateDataColumnsForDynamicDataGrid]
(
	@DataGridItemId UNIQUEIDENTIFIER
)
AS
BEGIN

	DECLARE @SchemaName NVARCHAR(64);
	DECLARE @TableOrViewName NVARCHAR(256);
	DECLARE @Json NVARCHAR(MAX);
    
	SELECT @SchemaName = [dgs].[SchemaName]
	,@TableOrViewName = [dgs].[TableOrViewName]
	,@Json = [dgs].[RequestModel]
	FROM
	 [RecPortal].[DataGridSetting] [dgs] WHERE [dgs].[Id] = @DataGridItemId;
	
	-- Validate the data columns
	DECLARE @DataColumn TABLE 
	(
		[ColumnName] NVARCHAR(100)
		,[DataType] NVARCHAR(100)
		,[DisplayName] NVARCHAR(MAX)
		,[IsVisible] BIT
		,[Sortable] BIT
		,[Filterable] BIT
		,[ValidColumn] BIT
		,[Computed] NVARCHAR(MAX)
	);

	INSERT INTO @DataColumn ([ColumnName], [DataType], [DisplayName], [IsVisible], [Sortable], [Filterable], [Computed])
	SELECT 
	[ColumnName]
	,[DataType]
	,[DisplayName]
	,[IsVisible]
	,[Sortable]
	,[Filterable]
	,[Computed]
	FROM
	 OPENJSON(@Json)
	 WITH ([ColumnName] NVARCHAR(100), [DataType] NVARCHAR(100), [DisplayName] NVARCHAR(MAX), [IsVisible] BIT, [Sortable] BIT, [Filterable] BIT, [Computed] NVARCHAR(MAX))

	-- Check to see if the main table or view exists
	IF NOT EXISTS (SELECT *
					FROM
					[INFORMATION_SCHEMA].[COLUMNS] [c]
					WHERE
					[c].[TABLE_SCHEMA] = @SchemaName
					AND [c].[TABLE_NAME] = @TableOrViewName)
	BEGIN
		RAISERROR('Table or View does not exist', 16, 1);
	END;

	-- Check in the information schema to see if the columns exist
	UPDATE @DataColumn
	SET [ValidColumn] = CASE WHEN EXISTS (SELECT *
										  FROM
										   [INFORMATION_SCHEMA].[COLUMNS] [c]
										  WHERE
										   [c].[TABLE_SCHEMA] = @SchemaName
										   AND [c].[TABLE_NAME] = @TableOrViewName
										   AND [dc].[ColumnName] = [c].[COLUMN_NAME]) THEN 1 ELSE 0 END
	FROM @DataColumn [dc];

	-- Update any computed columns
	UPDATE @DataColumn
	SET [ValidColumn] = 1
	WHERE [Computed] <> '';

	-- Delete columns that we are unable to validate
	DELETE [dc] FROM @DataColumn [dc] WHERE [dc].[ValidColumn] = 0;

    SELECT 
	[dc].[ColumnName]
    ,[dc].[DataType]
    ,[dc].[DisplayName]
    ,[dc].[IsVisible]
    ,[dc].[Sortable]
    ,[dc].[Filterable]
    ,[dc].[ValidColumn] 
	,[dc].[Computed]
	FROM @DataColumn [dc];

END;
GO
