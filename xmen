--Hui -11/03/2019 - Changed migration script to dynamic sql
--------------------------------------
CREATE PROCEDURE [WebServices].[EnterprisePayrollMigrationScript]
AS
    BEGIN
        SET NOCOUNT ON;

        DECLARE @QueryString NVARCHAR(MAX);

        SET @QueryString = N'IF EXISTS (   SELECT *
              FROM   dbo.PluginPackages
              WHERE  FullName LIKE ''Fcs.RdbPlugins.EnterprisePayrollExport%'' )
    BEGIN
        INSERT INTO WebServices.EnterprisePayrollClientRef
        (
            ClientId ,
            EnterpriseClientRef ,
            CreatedUserId ,
            CreatedOn ,
            UpdatedUserId ,
            UpdatedOn
        )
                    SELECT C.ClientID ,
                           C.OurReference ,
                           C.CreatedUserId ,
                           GETDATE() ,
                           C.UpdatedUserId ,
                           GETDATE()
                    FROM   dbo.Clients C
                    WHERE  NOT EXISTS (   SELECT *
                                          FROM   WebServices.EnterprisePayrollClientRef EC
                                          WHERE  EC.ClientId = C.ClientID )
                           AND ISNULL(C.OurReference, N'''') <> N''''
                           AND LEN(C.OurReference) <= 20;

        SELECT C.ClientID ,
               C.Company ,
               N''Enterprise Payroll Ref has not been moved to browser due to OurReference has exceeded 20 characters limits.'' AS Error
        FROM   dbo.Clients C
        WHERE  LEN(C.OurReference) > 20;


        IF EXISTS (   SELECT *
                      FROM   INFORMATION_SCHEMA.COLUMNS
                      WHERE  TABLE_NAME = N''EnterpriseExportedTimesheets''
                             AND TABLE_SCHEMA = N''FCS''
                             AND COLUMN_NAME IN ( ''TimesheetId'', ''CreatedOn'', ''CreatedUserId'' ))
            BEGIN
                INSERT INTO WebServices.EnterprisePayrollExportedTimesheets
                (
                    TimesheetId ,
                    CreatedUserId ,
                    CreatedOn
                )
                            SELECT ET.TimesheetId ,
                                   ET.CreatedUserId ,
                                   ET.CreatedOn
                            FROM   [FCS].[EnterpriseExportedTimesheets] ET
                            WHERE  NOT EXISTS (   SELECT *
                                                  FROM   WebServices.EnterprisePayrollExportedTimesheets T
                                                  WHERE  T.TimesheetId = ET.TimesheetId );

                DELETE [FCS].[EnterpriseExportedTimesheets];
            END;
        ELSE
            BEGIN
                PRINT ''No FCS.EnterpriseExportedTimesheets table to be exported or missing columns in the FCS.EnterpriseExportedTimesheets to complete the migration.'' ;
            END;
    END;
ELSE
    BEGIN
        PRINT N''Unable to run the migration script for Enterprise Payroll Export Desktop Plugin has not been installed.'';
    END;';

        EXECUTE sp_executesql @QueryString;
    END;
GO
