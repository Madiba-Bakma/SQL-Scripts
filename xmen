CREATE PROCEDURE [dbo].[CUSTOM_DEFINED_COLUMN_DELETE]
    (
      @AW_USERID INT,
      @AW_TABLENAME NVARCHAR(50),
      @AW_COLUMNNAME NVARCHAR(50)
    )
AS 
    BEGIN
        DECLARE @CUSTOMDEFINEDCOLUMNID INT,
            @LOOKUPLISTID INT

        SELECT DISTINCT
                @CUSTOMDEFINEDCOLUMNID = CC.CUSTOMDEFINEDCOLUMNID,
                @LOOKUPLISTID = ISNULL(CC.LOOKUPLISTID, 0)
        FROM    CUSTOMDEFINEDCOLUMNS CC,
                SECTORDEFINEDCOLUMNS SC,
                SECTORUSERS SU
        WHERE   CC.TABLENAME = @AW_TABLENAME
                AND CC.COLUMNNAME = @AW_COLUMNNAME
                AND CC.CUSTOMDEFINEDCOLUMNID = SC.CUSTOMDEFINEDCOLUMNID
                AND SC.SECTORID = SU.SECTORID
                AND SU.USERID = @AW_USERID
                AND SU.HASLOGGEDON = 'Y'

        IF ( @CUSTOMDEFINEDCOLUMNID IS NOT NULL ) 
            BEGIN
                DELETE  FROM SECTORDEFINEDCOLUMNS
                WHERE   CUSTOMDEFINEDCOLUMNID = @CUSTOMDEFINEDCOLUMNID
                        AND SECTORID IN ( SELECT    SECTORID
                                          FROM      SECTORUSERS
                                          WHERE     USERID = @AW_USERID
                                                    AND HASLOGGEDON = 'Y' )

                DELETE  FROM CUSTOMDEFINEDCOLUMNS
                WHERE   CUSTOMDEFINEDCOLUMNID = @CUSTOMDEFINEDCOLUMNID

		-- IF RECORD IS DELETED FROM CUSTOMDEFINEDCOLUMNS, THEN DROP THE COLUMN FROM THE 
		-- CORRESPONDING TABLE
                IF NOT EXISTS ( SELECT  CUSTOMDEFINEDCOLUMNID
                                FROM    CUSTOMDEFINEDCOLUMNS
                                WHERE   CUSTOMDEFINEDCOLUMNID = @CUSTOMDEFINEDCOLUMNID ) 
                    BEGIN
                        IF ( @LOOKUPLISTID > 0 ) 
                            BEGIN
                                if exists ( select  *
                                            from    information_schema.table_constraints
                                            where   constraint_name = @AW_TABLENAME 
                                                    + '_' + @AW_COLUMNNAME
                                                    + '_FK' ) 
                                    BEGIN
                                        EXEC
                                            ( 'ALTER TABLE ' + @AW_TABLENAME
                                              + '
										   DROP CONSTRAINT '
                                              + @AW_TABLENAME + '_'
                                              + @AW_COLUMNNAME + '_FK'
                                            )
                                    END
                                    
                            END

                        EXEC ( 'ALTER TABLE ' + @AW_TABLENAME + '
								DROP COLUMN ' + @AW_COLUMNNAME
                            )

                    END
            END
    END
GO
