        EXEC WebServices.MergeApplicantCustom @OriginalMergeId = @OriginalMergeId,
                                              @NewMergeId = @NewMergeId

        DELETE AC
        FROM dbo.ApplicantConsultants AC
            INNER JOIN dbo.ApplicantConsultants AC2 ON ISNULL(AC.UserId, -1) = ISNULL(AC2.UserId, -1)
                                                    AND ISNULL(AC.UserGroupId, -1) = ISNULL(AC2.UserGroupId, -1)
