CREATE   PROCEDURE [WebServices].[MergeClientContact]
    (
        @OriginalMergeId INT,
        @NewMergeId INT
    )
AS
    BEGIN
        SET NOCOUNT ON;

        DELETE A
        FROM dbo.ClientContactAttributes A
            INNER JOIN dbo.ClientContactAttributes B ON A.AttributeId = B.AttributeId
        WHERE A.ClientContactId = @OriginalMergeId
            AND B.ClientContactId = @NewMergeId

        UPDATE dbo.ClientContactAttributes
        SET ClientContactId = @NewMergeId
        WHERE ClientContactId = @OriginalMergeId

        DELETE A
        FROM dbo.ContactConsultants A
            INNER JOIN dbo.ContactConsultants B ON ISNULL(A.UserId, -1) = ISNULL(B.UserId, -1)
                                                AND ISNULL(A.UserGroupId, -1) = ISNULL(B.UserGroupId, -1)
        WHERE A.ClientContactId = @OriginalMergeId
            AND B.ClientContactId = @NewMergeId

        BEGIN TRY
            UPDATE dbo.ContactConsultants
            SET ClientContactId = @NewMergeId
            WHERE ClientContactId = @OriginalMergeId
        END TRY
        BEGIN CATCH
            PRINT 'Warning: contact consultants dropped as they could not be merged'
            DELETE FROM dbo.ContactConsultants
            WHERE ClientContactId = @OriginalMergeId
        END CATCH

        UPDATE dbo.ApplicantActions
        SET ClientContactId = @NewMergeId
        WHERE ClientContactId = @OriginalMergeId

        UPDATE dbo.Clients
        SET InvoiceContactId = @NewMergeId
        WHERE InvoiceContactId = @OriginalMergeId

