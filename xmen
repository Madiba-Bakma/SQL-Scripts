-- DO 9 Aug 22 - FC-16276 Rebuild primary index after column delete
-----------------------------------------------------------------------    
CREATE PROCEDURE [WebServices].[CustomColumnDefinedFieldDelete]
    --   @ColumnName NVARCHAR(MAX),    

    @CustomDefinedColumnId INT ,
    @UserId INT
AS
    IF EXISTS (   SELECT *
                  FROM   dbo.CustomDefinedColumns CC
                  WHERE  CC.CustomDefinedColumnId = @CustomDefinedColumnId )
        BEGIN

            IF NOT EXISTS (   SELECT *
                              FROM   dbo.SectorDefinedColumns SC
                              WHERE  SC.CustomDefinedColumnId = @CustomDefinedColumnId
                                     AND SC.SectorId NOT IN (   SELECT SectorId
                                                                FROM   SectorUsers
                                                                WHERE  UserId = @UserId
                                                                       AND HasLoggedOn = 'Y' ))
                BEGIN

                    DECLARE @AW_TABLENAME NVARCHAR(MAX);
                    DECLARE @AW_COLUMNNAME NVARCHAR(MAX);
                    DECLARE @LOOKUPLISTID INT;




                    SELECT DISTINCT @AW_TABLENAME = CC.TableName ,
                                    @AW_COLUMNNAME = CC.ColumnName ,
                                    @LOOKUPLISTID = ISNULL(CC.LookupListId, 0)
                    FROM   dbo.CustomDefinedColumns CC ,
                           dbo.SectorDefinedColumns SC ,
                           dbo.SectorUsers SU
                    WHERE  SC.SectorId = SU.SectorId
                           AND SU.UserId = @UserId
                           AND SU.HasLoggedOn = 'Y'
                           AND CC.CustomDefinedColumnId = @CustomDefinedColumnId;


                    IF EXISTS (   SELECT *
                                  FROM   dbo.SearchConditions
                                  WHERE  CustomColumnId = @CustomDefinedColumnId )
                        BEGIN
                            DELETE FROM dbo.SearchConditions
                            WHERE CustomColumnId = @CustomDefinedColumnId;
                        END;



                    DELETE FROM SectorDefinedColumns
                    WHERE CustomDefinedColumnId = @CustomDefinedColumnId
                          AND SectorId IN (   SELECT SectorId
                                              FROM   SectorUsers
                                              WHERE  UserId = @UserId
                                                     AND HasLoggedOn = 'Y' );


                    -- drop the column and any related constraints from the relevant table
                    IF ( @LOOKUPLISTID > 0 )
                        BEGIN
                            IF EXISTS (   SELECT *
                                            FROM   INFORMATION_SCHEMA.TABLE_CONSTRAINTS
                                            WHERE  CONSTRAINT_NAME = @AW_TABLENAME + '_' + @AW_COLUMNNAME + '_FK' )
                                BEGIN
                                    EXEC ( 'ALTER TABLE ' + @AW_TABLENAME + '  
        DROP CONSTRAINT '              + @AW_TABLENAME + '_' + @AW_COLUMNNAME + '_FK' );
                                END;

                        END;

                    EXEC ( 'ALTER TABLE ' + @AW_TABLENAME + '  
DROP COLUMN '       + @AW_COLUMNNAME );

					-- finally, delete the customdefinedcolumns row - this needs to be done after altering the table
					-- as the trigger-related code will refresh some dependant views
                    DELETE FROM CustomDefinedColumns
                    WHERE CustomDefinedColumnId = @CustomDefinedColumnId;

                END;
            ELSE
                BEGIN
                    DECLARE @SECTORNAME AS NVARCHAR(MAX);
                    SELECT @SECTORNAME = STUFF((   SELECT ',' + COALESCE(S.SectorName, ',')
                                                   FROM   dbo.SectorDefinedColumns SC
                                                          JOIN dbo.Sectors S ON S.SectorId = SC.SectorId
                                                   WHERE  SC.CustomDefinedColumnId = @CustomDefinedColumnId
                                                          AND SC.SectorId NOT IN (   SELECT SectorId
                                                                                     FROM   SectorUsers
                                                                                     WHERE  UserId = @UserId
                                                                                            AND HasLoggedOn = 'Y' )
                                                   FOR XML PATH('')) ,
                                               1 ,
                                               1 ,
                                               '');


                    RAISERROR('Delete record fails, The user is not logged into the following sectors %s', 14, 2, @SECTORNAME);


                END;

            UPDATE MetaData.App
            SET    LastUpdated = GETDATE();

        END;
GO
