                            @UserId ,                                                            -- UpdatedUserId - int  
                            NULL ,                                                               -- Rate - numeric(14, 2)  
                            [CP].[ChargeUnitValueId] ,                                           -- RateUnitId - int  
                            NULL                                                                 -- WorkHistoryTypeId - int  
                     FROM   [dbo].[Placements] [P]
                            LEFT OUTER JOIN [dbo].[Jobs] [J] ON [J].[JobId] = [P].[PlacementID]
                            LEFT OUTER JOIN [dbo].[Clients] [C] ON [C].[ClientID] = [P].[ClientID]
                            LEFT OUTER JOIN [dbo].[ContractPlacements] [CP] ON [CP].[PlacementId] = [P].[PlacementID]
                            INNER JOIN [dbo].[Person] [PER] ON [PER].[PersonID] = [P].[ApplicantId]
                     WHERE  [P].[PlacementID] = @NewPlacementId);


		-- Custom columns --

		EXEC [WebServices].CustomDefinedColumnTableInsertForObject @Type='PLACEMENT', @Id=@NewPlacementId, @UserId=@UserId;

		DECLARE custom_clause_cursor CURSOR READ_ONLY FOR
           SELECT 'C1.'+CDC.ColumnName+'=C2.'+CDC.ColumnName AS set_clause
           FROM dbo.CustomDefinedColumns CDC
           WHERE CDC.TableName = 'PlacementSectorDefinedColumns'
           AND EXISTS (
	         SELECT 1 FROM INFORMATION_SCHEMA.COLUMNS COLS
	         WHERE COLS.TABLE_NAME = 'PlacementSectorDefinedColumns'
	         AND COLS.COLUMN_NAME = CDC.ColumnName);
	    DECLARE @set_clause NVARCHAR(120);
		DECLARE @update_custom NVARCHAR(max) = '';

        OPEN custom_clause_cursor;
		FETCH NEXT FROM custom_clause_cursor INTO @set_clause;
		WHILE @@FETCH_STATUS = 0
		BEGIN
		   SET @update_custom = @update_custom + ','+@set_clause
           FETCH NEXT FROM custom_clause_cursor INTO @set_clause;
		END
		CLOSE custom_clause_cursor;
		DEALLOCATE custom_clause_cursor;

		IF @update_custom <> N''
			BEGIN
				SET @update_custom = SUBSTRING(@update_custom, 2, LEN(@update_custom) - 1);

				SET @update_custom = N'UPDATE C1 SET ' + @update_custom
									 + N' FROM dbo.PlacementSectorDefinedColumns C1, dbo.PlacementSectorDefinedColumns C2 '
									 + N'WHERE c1.PlacementId=' + CAST(@NewPlacementId AS NVARCHAR(16))
									 + N' AND c2.PlacementId=' + CAST(@PlacementId AS NVARCHAR(16));

				EXECUTE ( @update_custom );
			END;
		
		--------------------

        EXEC [WebServices].[PlacementAfterSave] @RecordId = @NewPlacementId , -- int
                                                @IsNew = 1 ,                  -- bit
                                                @UserId = @UserId;            -- int

        SELECT @NewPlacementId;

    END;
