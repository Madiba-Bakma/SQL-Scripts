    CREATE PROCEDURE [MergeSuite].[Applicants]
    (
      @Keep INT ,
      @Merge INT ,
      @UserId INT 
    )
AS 
    BEGIN
/*
Do not customise this stored procedure, use ApplicantsCustom which is called before this procedure
*/
        SET ANSI_NULLS ON
        SET NOCOUNT ON
  
        IF  EXISTS ( SELECT *
                         FROM   [dbo].APPLICANTS
                         WHERE  APPLICANTID = @Merge )
            AND NOT EXISTS ( SELECT *
                             FROM   [dbo].APPLICANTS
                             WHERE  APPLICANTID = @Keep ) 
            BEGIN
                INSERT  INTO [dbo].Applicants
                        ( ApplicantId ,
                          CreatedOn ,
                          CreatedUserId
                        )
                VALUES  ( @Keep ,
                          GETDATE() ,
                          1
                        )
            END
        

        UPDATE  [dbo].[ApplicantActions]
        SET     [ApplicantId] = @Keep
        WHERE   [ApplicantId] = @Merge

        IF NOT EXISTS ( SELECT  *
                        FROM    [dbo].[ApplicantBanks]
                        WHERE   [ApplicantId] = @Keep ) 
            BEGIN
                UPDATE  [dbo].[ApplicantBanks]
                SET     [ApplicantId] = @Keep
                WHERE   [ApplicantId] = @Merge

            END
        ELSE 
            BEGIN
                DELETE  FROM [dbo].[ApplicantBanks]
                WHERE   [ApplicantId] = @Merge
            END

        DELETE  A
        FROM    [dbo].ApplicantConsultants A
                INNER JOIN [dbo].ApplicantConsultants B ON ISNULL(A.UserId, -1) = ISNULL(B.UserId, -1)
                                                           AND ISNULL(A.UserGroupId, -1) = ISNULL(B.UserGroupId, -1)
        WHERE   A.ApplicantId = @Merge
                AND B.ApplicantId = @Keep

        UPDATE  [dbo].APPLICANTCONSULTANTS
        SET     USERRELATIONSHIPID = ( SELECT TOP 1
                                                USERRELATIONSHIPID
                                       FROM     [dbo].USERRELATIONSHIPS
                                       WHERE    SYSTEMCODE = 'USR_REL_SECONDARY'
                                     )
        WHERE   APPLICANTID = @Merge
                AND USERRELATIONSHIPID = ( SELECT TOP 1
                                                    USERRELATIONSHIPID
                                           FROM     [dbo].USERRELATIONSHIPS
                                           WHERE    SYSTEMCODE = 'USR_REL_PRIMARY'
                                         )
                AND EXISTS ( SELECT *
                             FROM   [dbo].APPLICANTCONSULTANTS
                             WHERE  APPLICANTID = @Keep
                                    AND USERRELATIONSHIPID = ( SELECT TOP 1
                                                                        USERRELATIONSHIPID
                                                               FROM     [dbo].USERRELATIONSHIPS
                                                               WHERE    SYSTEMCODE = 'USR_REL_PRIMARY'
                                                             ) )
        BEGIN TRY
  
            UPDATE  [dbo].[ApplicantConsultants]
            SET     [ApplicantId] = @Keep
            WHERE   [ApplicantId] = @Merge
    
        END TRY
        BEGIN CATCH
  
            PRINT 'Warning: Applicant consultants dropped as they could not be merged'
            DELETE  FROM [dbo].applicantconsultants
            WHERE   applicantid = @Merge
    
        END CATCH
  
        IF NOT EXISTS ( SELECT  *
                        FROM    [dbo].[ApplicantEmpDetails]
                        WHERE   [ApplicantId] = @Keep ) 
            BEGIN 
                UPDATE  [dbo].[ApplicantEmpDetails]
                SET     [ApplicantId] = @Keep
                WHERE   [ApplicantId] = @Merge

            END 
        ELSE 
            BEGIN 
                DELETE  FROM [dbo].[ApplicantEmpDetails]
                WHERE   [ApplicantId] = @Merge
            END

 
  
        DELETE  A
        FROM    [dbo].ApplicantEmploymentTypes A
                INNER JOIN [dbo].ApplicantEmploymentTypes B ON A.EmploymentTypeId = B.EmploymentTypeId
        WHERE   A.ApplicantId = @Merge
                AND B.ApplicantId = @Keep



        UPDATE  [dbo].[ApplicantEmploymentTypes]
        SET     [ApplicantId] = @Keep
        WHERE   [ApplicantId] = @Merge

        DELETE  A
        FROM    [dbo].ApplicantExcludedAreas A
                INNER JOIN [dbo].ApplicantExcludedAreas B ON A.AttributeMasterId = B.AttributeMasterId
                                                             AND A.AttributeId = B.AttributeId
        WHERE   A.ApplicantId = @Merge
                AND B.ApplicantId = @Keep



        UPDATE  [dbo].[ApplicantExcludedAreas]
        SET     [ApplicantId] = @Keep
        WHERE   [ApplicantId] = @Merge
	

        DELETE  A
        FROM    [dbo].ApplicantExcludedClients A
                INNER JOIN [dbo].ApplicantExcludedClients B ON A.ClientId = B.ClientId
        WHERE   A.ApplicantId = @Merge
                AND B.ApplicantId = @Keep


        UPDATE  [dbo].[ApplicantExcludedClients]
        SET     [ApplicantId] = @Keep
        WHERE   [ApplicantId] = @Merge


        IF NOT EXISTS ( SELECT  *
                        FROM    [dbo].[ApplicantProfile]
                        WHERE   [ApplicantId] = @Keep ) 
            BEGIN
                UPDATE  [dbo].[ApplicantProfile]
                SET     [ApplicantId] = @Keep
                WHERE   [ApplicantId] = @Merge

            END
        ELSE 
            BEGIN
                DELETE  FROM [dbo].[ApplicantProfile]
                WHERE   [ApplicantId] = @Merge
            END
        UPDATE  [dbo].[ApplicantRates]
        SET     [ApplicantId] = @Keep
        WHERE   [ApplicantId] = @Merge

        IF NOT EXISTS ( SELECT  *
                        FROM    [dbo].[ApplicantSectorDefinedColumns]
                        WHERE   [ApplicantID] = @Keep ) 
            BEGIN 
                UPDATE  [dbo].[ApplicantSectorDefinedColumns]
                SET     [ApplicantID] = @Keep
                WHERE   [ApplicantID] = @Merge

            END 
        ELSE 
            BEGIN 
                DELETE  FROM [dbo].[ApplicantSectorDefinedColumns]
                WHERE   [ApplicantID] = @Merge
            END


        IF NOT EXISTS ( SELECT  *
                        FROM    [dbo].[BatchApplicants]
                        WHERE   [ApplicantId] = @Keep ) 
            BEGIN
                UPDATE  [dbo].[BatchApplicants]
                SET     [ApplicantId] = @Keep
                WHERE   [ApplicantId] = @Merge

            END
        ELSE 
            BEGIN
                DELETE  FROM [dbo].[BatchApplicants]
                WHERE   [ApplicantId] = @Merge
            END
        UPDATE  [dbo].[CV]
        SET     [ApplicantId] = @Keep
        WHERE   [ApplicantId] = @Merge 
        UPDATE  [dbo].[Invoices]
        SET     [ApplicantID] = @Keep
        WHERE   [ApplicantID] = @Merge 

        DELETE  A
        FROM    [dbo].PreferredLists A
                INNER JOIN PreferredLists B ON A.ClientId = B.ClientId
        WHERE   A.ApplicantId = @Merge
                AND B.ApplicantId = @Keep

        UPDATE  [dbo].[PreferredLists]
        SET     [ApplicantId] = @Keep
        WHERE   [ApplicantId] = @Merge

        UPDATE  [dbo].[ReviewListApplicants]
        SET     [ApplicantId] = @Keep
        WHERE   [ApplicantId] = @Merge

        DELETE  FROM [dbo].ReviewListApplicants
        WHERE   ReviewListApplicantId IN ( SELECT   MIN(ReviewListApplicantId)
                                           FROM     [dbo].ReviewListApplicants
                                           WHERE    ApplicantId = @Keep
                                           GROUP BY ApplicantId ,
                                                    ReviewListId
                                           HAVING   COUNT(ApplicantId) > 1 )


      

        UPDATE  [dbo].[WorkHistory]
        SET     [ApplicantID] = @Keep
        WHERE   [ApplicantID] = @Merge
        

        IF EXISTS ( SELECT  *
                    FROM    INFORMATION_SCHEMA.TABLES
                    WHERE   TABLE_NAME = 'JSN_NEWAPPLICANTS' ) 
            BEGIN
                DECLARE @SQL VARCHAR(MAX)
                SET @SQL = 'Update [dbo].[JSN_NEWAPPLICANTS] 
                    SET [APPLICANTID] = ' + CAST(@Keep AS VARCHAR(MAX)) + ' 
                    WHERE [APPLICANTID] = ' + CAST(@Merge AS VARCHAR(MAX)) + ' AND NOT EXISTS (SELECT * FROM [dbo].JSN_NEWAPPLICANTS WHERE APPLICANTID = ' + CAST(@Keep AS VARCHAR(MAX)) + ') DELETE FROM [dbo].JSN_NEWAPPLICANTS WHERE APPLICANTID = ' + CAST(@Merge AS VARCHAR(MAX)) 
                EXEC (@SQL)
            END

        UPDATE  [dbo].[Placements]
        SET     [ApplicantID] = @Keep
        WHERE   [ApplicantID] = @Merge
      
        DELETE  FROM [dbo].Applicants
        WHERE   ApplicantId = @Merge



    END

