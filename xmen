----------------------------------------------------------------------                

-- History                

----------------------------------------------------------------------                

-- AT - 25/11/2016 The Applicant Delete Script has been extended as follows                

--  - Removal of linked records from dbo.PreferredLists                

--  - Remove of linked Availability Diaries                

--  - Removal of linked Tasks                

--  - Removal of items linked to Notebook Items - Tasks, Diaries and MailshotSendRecipients                

--  RM - 20/09/2018 - Delete from CV.Parser matach object table - FC-2881    

--  KJ - 02/07/2019 - FC-4509 - Fixed and improved deletion process             

----------------------------------------------------------------------    



CREATE PROCEDURE [dbo].[APPLICANT_DELETE]
    (
        @AW_APPLICANTID INT ,
        @AW_UPDATEDTIMESTAMP TIMESTAMP ,
        @UserId INT
    )
AS
    BEGIN

        IF EXISTS (   SELECT *
                      FROM   dbo.Applicants
                      WHERE  ApplicantId = @AW_APPLICANTID )
            BEGIN

                IF EXISTS (   SELECT *
                              FROM   dbo.Applicants
                              WHERE  ApplicantId = @AW_APPLICANTID
                                     AND UpdatedTimestamp = @AW_UPDATEDTIMESTAMP )
                    BEGIN



                        --App actions                    

                        IF ((   SELECT COUNT(ApplicantActionId)
                                FROM   dbo.ApplicantActions
                                WHERE  ApplicantId = @AW_APPLICANTID ) > 0 )
                            BEGIN

                                RAISERROR('This record is referenced in the applicant action table', 16, 1);

                                RETURN;

                            END;



                        -- Checking for any placements                     

                        IF ((   SELECT COUNT(PlacementID)
                                FROM   dbo.Placements
                                WHERE  ApplicantId = @AW_APPLICANTID ) > 0 )
                            BEGIN

                                RAISERROR('This record is referenced in the placements table', 16, 1);

                                RETURN;

                            END;



                        -- Checking any ReviewListApplicant                    



                        IF ((   SELECT COUNT(ReviewListId)
                                FROM   dbo.ReviewListApplicants
                                WHERE  ApplicantId = @AW_APPLICANTID ) > 0 )
                            BEGIN

                                RAISERROR('This record is referenced in review list table', 16, 1);

                                RETURN;

                            END;







                        --Delete Object Diaries                    

                        DECLARE @ObjectDiaryIds TABLE
                            (
                                ObjectDiaryId INT
                            );

                        INSERT INTO @ObjectDiaryIds ( ObjectDiaryId )
                                    SELECT ObjectDiaryId
                                    FROM   dbo.ObjectDiary
                                    WHERE  ApplicantId = @AW_APPLICANTID;



                        DELETE FROM dbo.ObjectDiaryVariance
                        WHERE ObjectDiaryId IN (   SELECT ObjectDiaryId
                                                   FROM   @ObjectDiaryIds );



                        DELETE FROM dbo.ObjectDiaryRecurrence
                        WHERE ObjectDiaryId IN (   SELECT ObjectDiaryId
                                                   FROM   @ObjectDiaryIds );



                        DELETE FROM dbo.ObjectDiary
                        WHERE ObjectDiaryId IN (   SELECT ObjectDiaryId
                                                   FROM   @ObjectDiaryIds );

                        -------------                    



                        DELETE FROM dbo.PreferredLists
                        WHERE ApplicantId = @AW_APPLICANTID;



                        DELETE FROM dbo.CVContents
                        WHERE CVId IN (   SELECT CVId
                                          FROM   dbo.CV
                                          WHERE  ApplicantId = @AW_APPLICANTID );

                        DELETE FROM dbo.CV
                        WHERE ApplicantId = @AW_APPLICANTID;

                        DELETE FROM dbo.BatchApplicants
                        WHERE ApplicantId = @AW_APPLICANTID;

                        DELETE FROM dbo.ApplicantBanks
                        WHERE ApplicantId = @AW_APPLICANTID;

                        DELETE FROM dbo.WorkHistoryAttributes
                        WHERE WorkHistoryId IN (   SELECT WorkHistoryId
                                                   FROM   dbo.WorkHistory
                                                   WHERE  ApplicantID = @AW_APPLICANTID );

                        DELETE FROM dbo.WorkHistory
                        WHERE ApplicantID = @AW_APPLICANTID;

                        DELETE FROM dbo.ApplicantConsultants
                        WHERE ApplicantId = @AW_APPLICANTID;

                        DELETE FROM dbo.ApplicantProfile
                        WHERE ApplicantId = @AW_APPLICANTID;

                        DELETE FROM dbo.ApplicantEmpDetails
                        WHERE ApplicantId = @AW_APPLICANTID;

                        DELETE FROM dbo.ApplicantSectorDefinedColumns
                        WHERE ApplicantID = @AW_APPLICANTID;

                        DELETE FROM dbo.ApplicantExcludedAreas
                        WHERE ApplicantId = @AW_APPLICANTID;

