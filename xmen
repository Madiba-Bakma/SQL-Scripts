        UPDATE dbo.ApplicantConsultants
        SET    UserRelationshipId = (SELECT TOP 1 UserRelationshipId FROM dbo.UserRelationships WHERE SystemCode = 'USR_REL_SECONDARY')
        WHERE  ApplicantId = @OriginalMergeId
            AND UserRelationshipId = (SELECT TOP 1 UserRelationshipId FROM dbo.UserRelationships WHERE SystemCode = 'USR_REL_PRIMARY')
            AND EXISTS (SELECT * FROM dbo.ApplicantConsultants WHERE ApplicantId = @NewMergeId
                        AND UserRelationshipId = (SELECT TOP 1 UserRelationshipId FROM dbo.UserRelationships WHERE SystemCode = 'USR_REL_PRIMARY'));

        BEGIN TRY
