        SET CommercialManagerId = @NewMergeId
        WHERE CommercialManagerId = @OriginalMergeId

        UPDATE dbo.Placements
        SET HSManagerId = @NewMergeId
        WHERE HSManagerId = @OriginalMergeId

        UPDATE dbo.ProjectContacts
        SET ClientContactId = @NewMergeId
        WHERE ClientContactId = @OriginalMergeId

        UPDATE dbo.Projects
        SET PrimaryContactId = @NewMergeId
        WHERE PrimaryContactId = @OriginalMergeId

        DECLARE MERGECUSTOMCOLUMNS CURSOR
        FOR
            SELECT  TableName ,
                    ColumnName
            FROM    dbo.CustomDefinedColumns
            WHERE   ColumnType = 'Lookup'
                    AND TableName = 'ContactSectorDefinedColumns'

        OPEN MERGECUSTOMCOLUMNS

        DECLARE @TABLE VARCHAR(255)
        DECLARE @COLUMN VARCHAR(255)
        DECLARE @CUSTOMSQL VARCHAR(MAX)

        FETCH NEXT FROM MERGECUSTOMCOLUMNS INTO @TABLE, @COLUMN

        WHILE @@FETCH_STATUS = 0 
            BEGIN
                SET @CUSTOMSQL = 'UPDATE dbo.' + @TABLE + ' SET ' + @COLUMN + ' = ' + CAST(@NewMergeId AS VARCHAR(MAX)) + ' WHERE ' + @COLUMN + ' = ' + CAST(@OriginalMergeId AS VARCHAR(MAX))
                EXEC (@CUSTOMSQL)

                FETCH NEXT FROM MERGECUSTOMCOLUMNS INTO @TABLE, @COLUMN
            END

        CLOSE MERGECUSTOMCOLUMNS
        DEALLOCATE MERGECUSTOMCOLUMNS

        UPDATE dbo.Jobs
        SET ClientContactId = @NewMergeId  
        WHERE ClientContactId = @OriginalMergeId

        UPDATE dbo.ObjectDiary
        SET ClientContactId = @NewMergeId
        WHERE ClientContactId = @OriginalMergeId

        UPDATE WebServices.BatchEmailInvoiceAttachmentTemp
        SET ClientContactId = @NewMergeId
        WHERE ClientContactId = @OriginalMergeId

        UPDATE WebServices.BatchEmailInvoiceTemp
        SET ClientContactId = @NewMergeId
        WHERE ClientContactId = @OriginalMergeId

        UPDATE WebServices.BatchEmailTemp
        SET ClientContactId = @NewMergeId
        WHERE ClientContactId = @OriginalMergeId

        UPDATE WebServices.BatchMailshotTemp
        SET ClientContactId = @NewMergeId
        WHERE ClientContactId = @OriginalMergeId

        UPDATE WebServices.BatchSMSTemp
        SET ClientContactId = @NewMergeId
        WHERE ClientContactId = @OriginalMergeId

        UPDATE WebServices.CvSendEmailGroup
        SET ClientContactId = @NewMergeId
        WHERE ClientContactId = @OriginalMergeId

        UPDATE WebServices.MailshotEmailGroup
        SET ClientContactId = @NewMergeId
        WHERE ClientContactId = @OriginalMergeId

        UPDATE FCS.DeletionRequestMailshotSendRecipients
        SET ClientContactId = @NewMergeId
        WHERE ClientContactId = @OriginalMergeId

        DELETE FROM FCS.DeletionRequestContactsPendingDeletion
        WHERE ClientContactId = @OriginalMergeId

        IF NOT EXISTS ( SELECT * FROM dbo.ContactProfile WHERE ClientContactId = @NewMergeId )
            BEGIN
                UPDATE  dbo.ContactProfile
                SET     ClientContactId = @NewMergeId
                WHERE   ClientContactId = @OriginalMergeId
            END
        ELSE
            BEGIN
                DELETE  FROM dbo.ContactProfile WHERE ClientContactId = @OriginalMergeId
            END

        IF EXISTS ( SELECT  *
                    FROM    INFORMATION_SCHEMA.TABLES
                    WHERE   TABLE_NAME = 'jsn_client_report_access' )
            BEGIN
                DECLARE @SQL VARCHAR(MAX)
                SET @SQL = 'UPDATE dbo.jsn_client_report_access SET ClientContactID = '
                    + CAST(@NewMergeId AS VARCHAR(MAX))
                    + ' WHERE ClientContactID = '
                    + CAST(@OriginalMergeId AS VARCHAR(MAX))
                EXEC (@SQL)
            END

        DELETE FROM dbo.ClientContacts
        WHERE ClientContactId = @OriginalMergeId

    END
