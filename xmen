GO
CREATE PROCEDURE [WebServices].[MeritPayrollMigrationScript]
AS
    BEGIN

        SET NOCOUNT ON;

        DECLARE @Query NVARCHAR(MAX);

        SET @Query = N'
IF EXISTS (   SELECT *
              FROM   dbo.PluginPackages
              WHERE  FullName LIKE ''MeritPayrollExportPlugin%'' )
    BEGIN
        IF EXISTS (   SELECT *
                      FROM   INFORMATION_SCHEMA.COLUMNS
                      WHERE  TABLE_NAME = N''ExportedPlacements''
							 AND TABLE_SCHEMA = N''dbo''
                             AND COLUMN_NAME IN ( ''PlacementId'', ''ExportedDate'' ))
            BEGIN
                INSERT INTO WebServices.MeritPayrollExportedPlacements
                (
                    PlacementId ,
                    CreatedUserId ,
                    CreatedOn
                )
                            SELECT DISTINCT EP.placementid ,
                                            1 ,
                                            EP.ExportedDate
                            FROM   dbo.ExportedPlacements EP
                            WHERE  NOT EXISTS (   SELECT *
                                                  FROM   WebServices.MeritPayrollExportedPlacements MP
                                                  WHERE  MP.PlacementId = EP.placementid );

                DELETE dbo.ExportedPlacements;
            END;
        ELSE
            BEGIN                
                PRINT ''No dbo.ExportedPlacements table to be exported or missing columns in the dbo.ExportedPlacements to complete the migration .'';
            END;

        IF EXISTS (   SELECT *
                      FROM   INFORMATION_SCHEMA.COLUMNS
                      WHERE  TABLE_NAME = N''ExportedTimesheets''
						     AND TABLE_SCHEMA = N''dbo''
                             AND COLUMN_NAME IN ( ''TimesheetId'', ''CreatedOn'', ''CreatedUserId''))
            BEGIN
                INSERT INTO WebServices.MeritPayrollExportedTimesheets
                (
                    TimesheetId ,
                    CreatedUserId ,
                    CreatedOn
                )
                            SELECT DISTINCT ET.TimesheetId ,
                                            (   SELECT   TOP 1 E.CreatedUserId
                                                FROM     dbo.ExportedTimesheets E
                                                WHERE    E.TimesheetId = ET.TimesheetId
                                                ORDER BY E.CreatedOn ,
                                                         E.TimesheetId ) AS CreatedUserId ,
                                            (   SELECT   TOP 1 E.CreatedOn
                                                FROM     dbo.ExportedTimesheets E
                                                WHERE    E.TimesheetId = ET.TimesheetId
                                                ORDER BY E.CreatedOn ,
                                                         E.TimesheetId ) AS CreatedOn
                            FROM   dbo.ExportedTimesheets ET
                            WHERE  NOT EXISTS (   SELECT *
                                                  FROM   WebServices.MeritPayrollExportedTimesheets MT
                                                  WHERE  MT.TimesheetId = ET.TimesheetId );

                DELETE dbo.ExportedTimesheets;
            END;
        ELSE
            BEGIN               
                PRINT ''No dbo.ExportedTimesheets table to be exported or missing columns in the dbo.ExportedTimesheets to complete the migration .'';
            END;
    END;
ELSE
    BEGIN        
        PRINT ''Unable to run the migration script for Merit Payroll Export Desktop Plugin has not been installed.'';
    END;
'       ;

        EXECUTE sp_executesql @Query;

    END;
GO
