                                                             @AW_APPLICANTID))) = CONVERT(NVARCHAR(MAX), @AW_APPLICANTID)
                                           AND ( SELECT ( SUBSTRING((   SELECT   ',' + CONVERT(NVARCHAR(MAX), ObjectId)
