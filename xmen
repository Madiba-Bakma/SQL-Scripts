CREATE FUNCTION [RecPortal].[GenerateDataGridColumnDefinition]
(
	@TableOrViewName NVARCHAR(MAX)
	,@SchemaName NVARCHAR(256)
	,@ColumnsToGenerateJSON NVARCHAR(MAX)
)
RETURNS NVARCHAR(MAX)
AS
BEGIN

	DECLARE @Json NVARCHAR(MAX) = (SELECT '[' + STRING_AGG(
											'{"ColumnName": "' + [COLUMN_NAME] + 
											'", "DataType": "' + CASE 
																  WHEN [DATA_TYPE] = 'nvarchar' THEN UPPER([DATA_TYPE]) + '(' + 
																		CASE [CHARACTER_MAXIMUM_LENGTH] 
																		 WHEN -1 THEN 'MAX' 
																		 ELSE CONVERT(NVARCHAR(10), [CHARACTER_MAXIMUM_LENGTH]) 
																		END + ')' 
																  ELSE UPPER([DATA_TYPE]) END + 
											'", "DisplayName": "' + [COLUMN_NAME] + 
											'", "IsVisible": false, "Sortable": false, "Filterable": false, "Computed": ""}'
											, ',') + ']'
      
										FROM
											[INFORMATION_SCHEMA].[COLUMNS]
										WHERE
											[TABLE_NAME] = @TableOrViewName
											AND [TABLE_SCHEMA] = @SchemaName
											AND [COLUMN_NAME] IN (SELECT * FROM [dbo].[GET_STRING_TABLE_FROM_CSV](@ColumnsToGenerateJSON) [gstfc]));

	RETURN @Json;
END;
