CREATE PROCEDURE [WebServices].[SageLine50MigrationScript]
AS
    BEGIN

        SET NOCOUNT ON;

        DECLARE @CustomColumnQuery NVARCHAR(MAX) ,
                @QueryString NVARCHAR(MAX) ,
                @ParamDefinition NVARCHAR(MAX) ,
                @SageRefColName NVARCHAR(MAX) ,
                @HasColumn INT = 0;

        IF EXISTS (   SELECT *
                      FROM   dbo.PluginPackages
                      WHERE  FullName LIKE 'SageLine50Export%' )
            BEGIN
                IF EXISTS (   SELECT *
                              FROM   dbo.SystemParams
                              WHERE  ParamCode = N'SAGECLIENTREFFIELD' )
                    BEGIN
                        SELECT @SageRefColName = ParamValue
                        FROM   dbo.SystemParams
                        WHERE  ParamCode = N'SAGECLIENTREFFIELD';

                        IF ISNULL(@SageRefColName, N'') = N''
                            BEGIN
                                PRINT N'There are no defined Client Sage Line 50 column to be migrated.';
                            END;
                        ELSE
                            BEGIN

                                SET @CustomColumnQuery = N'IF EXISTS (   SELECT *
					  FROM   INFORMATION_SCHEMA.COLUMNS
					  WHERE  TABLE_NAME = N''ClientSectorDefinedColumns''
							 AND TABLE_SCHEMA = N''dbo''
							 AND COLUMN_NAME = N''CustomSagePayrollRef'' )
							 BEGIN
							      SET @HasColumnOutput = 1
							 END
							 '  ;

                                SET @CustomColumnQuery = REPLACE(@CustomColumnQuery, 'CustomSagePayrollRef', @SageRefColName);
                                SET @ParamDefinition = N' @HasColumnOutput INT OUTPUT';
                                EXECUTE sp_executesql @CustomColumnQuery ,
                                                      @ParamDefinition ,
                                                      @HasColumnOutput = @HasColumn OUTPUT;

                                IF @HasColumn = 1
                                    BEGIN
                                        SET @QueryString = N'INSERT INTO WebServices.SageLine50Clients
				(
					ClientId ,
					SageLine50Ref ,
					CreatedUserId ,
					CreatedOn ,
					UpdatedUserId ,
					UpdatedOn
				)
							SELECT CSDC.ClientID ,
								   CSDC.CustomSagePayrollRef ,
								   CSDC.CreatedUserId ,
								   GETDATE() ,
								   CSDC.UpdatedUserId ,
								   GETDATE()
